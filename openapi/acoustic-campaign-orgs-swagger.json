        },
        {
            "path":"/orgs/{orgId}/dll_whitelist_domains/{domainId}",
            "description":"Delete Domain from Org DLL Whitelist",
	        "operations":[
                {
                    "method":"DELETE",
                    "summary":"Delete Domain from Org DLL Whitelist",
