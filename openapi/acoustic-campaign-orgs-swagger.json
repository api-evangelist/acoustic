            "description":"Retrieve BCC Email Address.",
            "operations":[
                {
                    "method":"GET",
                    "summary":"Retrieve BCC Email Address",
                    "notes":"Use this API to get the Org BCC Address.",
                    "nickname":"org-bccemailaddress-get",
                    "responseClass":"BccAddress",
                    "parameters":[
                        {
                            "paramType": "path",
                            "name": "id",
                            "description": "Organization id",
                            "dataType": "String",
                            "required": true,
                            "allowMultiple": false
                        }
                    ]
                }
            ]
        },
        {
            "path":"/orgs/{id}/bccemailaddress",
            "description":"Set Org BCC Email Address",
            "operations":[
                {
                    "method":"PATCH",
                    "summary":"Update Org BCC Email Address",
                    "notes":"Use this API to set the Org BCC Address.",
                    "nickname":"org-bccemailaddress-put",
                    "responseClass":"",
                    "parameters":[
                        {
                            "paramType": "path",
                            "name": "id",
                            "description": "Organization id",
                            "dataType": "String",
                            "required": true,
                            "allowMultiple": false
                        },
                        {
                            "paramType": "body",
                            "name": "BccAddress",
                            "description": "BCC Email Address",
                            "dataType": "BccAddress",
                            "required": true,
                            "allowMultiple": false
                        }
                    ]
                }
            ]
        },
