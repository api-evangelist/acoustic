    "models": {
        "BccAddress": {
            "properties": {
                "email": {
                    "type": "String",
                    "description": "The Org's Bcc Email Address",
                    "required": true
           			}

      		}
   		},
        "DomainName": {
            "properties": {
                "name": {
                    "type": "String",
                    "description": "Domain Name to be added to the Org's DLL Whitelist",
                    "required": true
                }
            }
        },
        "DomainPostResponse" : {
            "properties": {
                "id": {
                    "type": "int",
                    "description": "Domain Id of Domain successfully added to Org's DLL Whitelist",
                    "required": true
                }
            }
        },
        "DomainGetResponse" : {
            "properties": {
                "id": {
                    "type": "int",
                    "description": "Domain Id of Domain in Org's DLL Whitelist",
                    "required": true
                },
                "name": {
                    "type": "String",
                    "description": "Domain Name of Domain in Org's DLL Whitelist",
                    "required": true
                },
                "createdBy": {
                    "type": "CreatedBy",
                    "description": "User data on who added the domain to the Org's Dll Whitelist",
                    "required": true,
                    "$ref":"CreatedBy"
                },
                "creationDate": {
                    "type": "Date",
                    "description": "When the domain was added to the Org's DLL Whitelist. Date is represented in a String as per ISO 8601",
                    "required": true
                }
            }
        },
        "CreatedBy": {
            "properties" : {
                "id" : {
                    "type": "int",
                    "description": "User ID2 of the user who added the domain to Org's DLL Whitelist",
                    "required": true
                },
                "firstName" : {
                    "type": "String",
                    "description": "First name of the user who added the domain to Org's DLL Whitelist",
                    "required": true
                },
                "lastName" : {
                    "type": "String",
                    "description": "Last name of the user who added the domain to Org's DLL Whitelist",
                    "required": true
                }
            }
        }
