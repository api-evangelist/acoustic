                            "required": true,
                            "allowMultiple": false
                        },
                        {
                            "paramType": "body",
                            "name": "name",
                            "description": "Domain Name",
                            "dataType": "DomainName",
                            "required": true,
                            "allowMultiple": false
                        }
                    ]
                }
            ]
        },
        {
